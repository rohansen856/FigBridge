{
  "name": "@figbridge/core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm/*": "./wasm/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/gen-schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1",
    "ajv": "^8.20.0",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17",
    "web-tree-sitter": "0.27.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  }
}
