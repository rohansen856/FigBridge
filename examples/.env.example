# Optional non-secret configuration consumed by FigBridge only if the manifest
# explicitly references the variable. This value is illustrative.
FIGMA_FILE_URL=https://www.figma.com/design/REPLACE_WITH_FILE_KEY/REPLACE_WITH_FILE_SLUG

# DO NOT put FIGMA_PAT or any other credential here for FigBridge.
# Enter the Figma personal access token through the extension's secure command,
# which stores it in VS Code SecretStorage.
